PORT=3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/gahar_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Super Admin Seed Credentials (never commit production credentials)
SUPER_ADMIN_EMAIL=superadmin@gahar.gov.eg
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password_here

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
