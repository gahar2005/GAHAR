# =============================================================================
# AccrediGo (GAHAR) — Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit real credentials, production secrets, or private keys to git.
# =============================================================================

# Core Environment
NODE_ENV=production
PORT=3000

# PostgreSQL / Supabase Database Connection
# In production, use your live Supabase or Render PostgreSQL pooled connection URL.
DATABASE_URL=postgresql://postgres:your_db_password@your-project-ref.supabase.co:5432/postgres?sslmode=require

# JWT Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Supabase Storage Configuration (Private document vault)
# SUPABASE_SERVICE_ROLE_KEY must remain strictly on the backend — never expose to client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_STORAGE_BUCKET=gahar-documents

# Super Admin Provisioning & Authentication
# The backend initializes/provisions this administrator account idempotently.
SUPER_ADMIN_EMAIL=superadmin@gahar.gov.eg
SUPER_ADMIN_PASSWORD=your_strong_production_admin_password_here

# AI Provider 1: Groq (Ultra-fast inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AI Provider 2: Google Gemini (Accreditation reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Provider 3: OpenAI (GPT fallback)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# SMTP Email Configuration (Nodemailer)
# Used for Registration Welcome, Super Admin Alerts, Payment Approval, and Password Reset.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.gahar-platform.eg
SMTP_PASS=your_smtp_password_here
SMTP_FROM="AccrediGo / GAHAR Platform" <no-reply@gahar-platform.eg>

# Web Application Base URL (for email links)
APP_BASE_URL=https://gahar-platform.eg
